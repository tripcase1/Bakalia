# Database Connection
DATABASE_URL="postgresql://alhera_user:alhera_password@localhost:5432/alherafresh_db?schema=public"

# App Environment
NODE_ENV="development"
PORT=4000
FRONTEND_URL="http://localhost:3000"

# JWT Authentication Secret
JWT_SECRET="super-secret-alhera-fresh-jwt-key-2026"
JWT_EXPIRES_IN="7d"

# Redis Config
REDIS_HOST="localhost"
REDIS_PORT=6379

# Cloudinary Config
CLOUDINARY_CLOUD_NAME="alherafresh"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Payment Gateways (bKash, Nagad, Rocket, SSLCommerz)
BKASH_APP_KEY="bkash-key"
BKASH_APP_SECRET="bkash-secret"
BKASH_USERNAME="bkash-user"
BKASH_PASSWORD="bkash-password"

NAGAD_MERCHANT_ID="nagad-merchant"
SSLCOMMERZ_STORE_ID="alherafresh_live"
SSLCOMMERZ_STORE_PASS="alherafresh_pass"
SSLCOMMERZ_IS_SANDBOX=true

# Google Analytics & Search Console
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
NEXT_PUBLIC_SITE_URL="https://alherafresh.com"
